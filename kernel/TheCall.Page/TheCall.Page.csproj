<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>TheCall.Page</AssemblyName>
    <RootNamespace>TheCall</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <CompressionEnabled>false</CompressionEnabled>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheCall.Rules\TheCall.Rules.csproj" />
    <WasmExtraFilesToDeploy Include="wwwroot\index.html" TargetPath="index.html" />
    <WasmExtraFilesToDeploy Include="wwwroot\bench.js" TargetPath="bench.js" />
    <WasmExtraFilesToDeploy Include="wwwroot\bench.css" TargetPath="bench.css" />
    <WasmExtraFilesToDeploy Include="..\..\Assets\StreamingAssets\call-book.json" TargetPath="call-book.json" />
  </ItemGroup>
</Project>
